:root{--accent:#e53935;--bg:#111;--card:#fff}
body{font-family:Inter,system-ui,Segoe UI,Arial;margin:0;background:#f5f5f5;color:#111}
.site-header{display:flex;justify-content:space-between;align-items:center;padding:12px 20px;background:#111;color:#fff}
.site-header a{color:#fff;margin-left:12px;text-decoration:none}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;padding:24px}
.product{background:#fff;border-radius:10px;padding:12px;box-shadow:0 6px 18px rgba(0,0,0,0.08);display:flex;flex-direction:column}
.product img{width:100%;height:160px;object-fit:cover;border-radius:8px}
.product h3{margin:10px 0 6px;font-size:16px}
.product p{margin:0 0 10px;color:#666}
.product .price{font-weight:700;margin-bottom:10px}
.btn{background:var(--accent);color:white;border:none;padding:8px 10px;border-radius:8px;cursor:pointer}
.cart-modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.5)}
.cart-content{background:#fff;padding:20px;border-radius:8px;min-width:320px;max-width:600px}
.hidden{display:none}
.cart-item{display:flex;gap:12px;align-items:center;padding:8px 0;border-bottom:1px solid #eee}
.cart-item img{width:64px;height:64px;object-fit:cover;border-radius:6px}
.cart-footer{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
